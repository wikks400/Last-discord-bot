# Required Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CLIENT_ID="your_discord_application_client_id_here"

# Required OpenSea API Key (v2)
# Obtain free/developer key from https://docs.opensea.io/
OPENSEA_API_KEY="your_opensea_api_key_here"

# Optional Discord Alert Destination Channel ID
# If unset, defaults to system notifications channel in connected server
ALERT_CHANNEL_ID=""

# Optional Custom SQLite Database Path (Default: ./data/bot.db)
DATABASE_PATH="./data/bot.db"

# Server Port
PORT=3000
